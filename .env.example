# Hermes Agent environment variables
# Copy this to %LOCALAPPDATA%\.env and fill in your values.
# Every profile gets a copy: cp %LOCALAPPDATA%\.env %LOCALAPPDATA%\hermes\profiles\<bot>\.env

# --- Required ---

# OpenRouter API key (https://openrouter.ai — free models need no card)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# --- Optional ---

# NVIDIA NIM API key (build.nvidia.com — free credits for fallback)
NVIDIA_API_KEY=nvapi-your-key-here

# Telegram Bot Token (for watchdog phone escalation)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# GitHub CLI token (for PR ops via prem-the-dev)
GITHUB_TOKEN_2=

# Ollama (local models — optional, needs 8GB+ RAM)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Default LLM provider and model
DEFAULT_LLM_PROVIDER=openrouter
DEFAULT_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Gateway profile name
GATEWAY_PROFILE=bunny
