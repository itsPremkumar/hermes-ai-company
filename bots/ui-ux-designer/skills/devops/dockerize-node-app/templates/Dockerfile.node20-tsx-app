# Verified-good Dockerfile for a Node/TS app that runs via `tsx` (no build step).
# Copy this into your project as `Dockerfile` and adjust ENV / health path.
#
# Why it works (avoids version/system errors):
#   - full `npm ci` (NOT --only=production) so `tsx` is present at runtime
#   - npm retry loop with proper exit-on-exhaustion guard (not silent success)
#   - python3-venv installed for PEP 668 Bookworm compatibility
#   - edge-tts installed in a venv (not direct pip — fails on Bookworm)
#   - non-root user for stability + security
#   - healthcheck hits the REAL route (/api/health) — change to match your app
#   - no apt ffmpeg (code uses bundled ffmpeg-static)
#   - NODE_OPTIONS cap prevents OOM on small boxes
#   - .dockerignore must be present — see the skill's .dockerignore section

FROM node:20-bookworm

LABEL org.opencontainers.image.title="(your app name)"
LABEL org.opencontainers.image.licenses="MIT"

WORKDIR /app

# System deps: python3-venv is REQUIRED on Bookworm (PEP 668).
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    chromium \
    fonts-liberation \
    fonts-noto-color-emoji \
    && rm -rf /var/lib/apt/lists/*

# Install pure-Python tools in a venv (PEP 668: Bookworm refuses direct pip).
RUN python3 -m venv /opt/venv && /opt/venv/bin/pip install --no-cache-dir edge-tts
ENV PATH="/opt/venv/bin:${PATH}"

# Full install (dev + prod) so `tsx` is present at runtime.
# Retry loop with exit guard — fails if all 3 attempts exhaust.
COPY package.json package-lock.json* ./
RUN npm config set fetch-retries 5 \
    && npm config set fetch-retry-mintimeout 20000 \
    && npm config set fetch-retry-maxtimeout 120000 \
    && npm config set fetch-timeout 300000 \
    && for i in 1 2 3; do \
         npm ci --prefer-offline --no-audit --no-fund && break \
         || echo "npm ci attempt $i failed (network), retrying..."; \
       done || { echo "ERROR: npm ci failed after 3 retries"; exit 1; }

COPY . .

RUN useradd -m -u 1001 appuser && chown -R appuser:appuser /app
USER appuser

ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
ENV PORT=3001
ENV NODE_ENV=production
ENV NODE_OPTIONS=--max-old-space-size=2048

EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD node -e "require('http').get('http://localhost:3001/api/health', r => process.exit(r.statusCode===200?0:1)).on('error', () => process.exit(1))"

CMD ["npm", "run", "dev"]
